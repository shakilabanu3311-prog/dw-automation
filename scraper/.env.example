# Copy to .env and fill in.
FREEPLAY_URL=https://panel.freeplay24.com/
FREEPLAY_USER=Maha0001
FREEPLAY_PASS=Asdf@1234

# Backend ingest endpoint + bearer token (Settings → Ingest token in the SPA)
BACKEND_URL=http://localhost:3000
INGEST_TOKEN=

# Headless or visible browser. Set HEADLESS=0 the first time so you can see
# what the scraper sees (and finish a captcha/2fa if any).
HEADLESS=1

# Re-scrape interval (seconds) when running in --watch mode.
POLL_SECONDS=60

# Optional: master code override. If set, all rows will be tagged with this
# master regardless of what's detected on the page (useful when one login
# manages multiple panels and you want to lock the panel slug).
MASTER_OVERRIDE=
